@database :memory:

# Regression tests for https://github.com/tursodatabase/turso/issues/8734

test update-set-window-rank-subquery {
    CREATE TABLE t(id INTEGER PRIMARY KEY, v INTEGER);
    INSERT INTO t VALUES(1,1),(2,2),(3,3),(4,4);
    UPDATE t SET v = (SELECT q FROM (SELECT id AS iid, row_number() OVER (ORDER BY v DESC) AS q FROM t) WHERE iid = t.id);
    SELECT id, v FROM t ORDER BY id;
}
expect {
    1|4
    2|3
    3|2
    4|1
}

test update-set-window-total-subquery {
    CREATE TABLE u(id INTEGER PRIMARY KEY, v INTEGER);
    INSERT INTO u VALUES(1,1),(2,2),(3,3);
    UPDATE u SET v = (SELECT q FROM (SELECT id AS iid, sum(v) OVER () AS q FROM u) WHERE iid = u.id);
    SELECT id, v FROM u ORDER BY id;
}
expect {
    1|6
    2|6
    3|6
}

test update-set-window-cte-rewrite {
    CREATE TABLE t(id INTEGER PRIMARY KEY, v INTEGER);
    INSERT INTO t VALUES(1,1),(2,2),(3,3),(4,4);
    UPDATE t SET v = (WITH r AS (SELECT id AS iid, row_number() OVER (ORDER BY v DESC) AS q FROM t) SELECT q FROM r WHERE iid = t.id);
    SELECT id, v FROM t ORDER BY id;
}
expect {
    1|4
    2|3
    3|2
    4|1
}

test update-set-window-column-not-read-by-window {
    CREATE TABLE w(id INTEGER PRIMARY KEY, x INTEGER, y INTEGER);
    INSERT INTO w VALUES(1,1,0),(2,2,0),(3,3,0),(4,4,0);
    UPDATE w SET y = (SELECT q FROM (SELECT id AS iid, row_number() OVER (ORDER BY x DESC) AS q FROM w) WHERE iid = w.id);
    SELECT id, y FROM w ORDER BY id;
}
expect {
    1|4
    2|3
    3|2
    4|1
}

test update-set-range-matched-subquery-sees-earlier-writes {
    CREATE TABLE h(id INTEGER PRIMARY KEY, v INTEGER);
    INSERT INTO h VALUES(1,1),(2,2),(3,3),(4,4);
    UPDATE h SET v = (SELECT count(*) FROM (SELECT DISTINCT v AS lv FROM h) WHERE lv <= h.id) * 5;
    SELECT id, v FROM h ORDER BY id;
}
expect {
    1|5
    2|5
    3|5
    4|5
}

test update-set-scalar-subquery-sees-earlier-writes {
    CREATE TABLE d(id INTEGER PRIMARY KEY, v INTEGER);
    INSERT INTO d VALUES(1,1),(2,2),(3,3),(4,4);
    UPDATE d SET v = (SELECT sum(q) FROM (SELECT v AS q FROM d) WHERE q <= d.v);
    SELECT id, v FROM d ORDER BY id;
}
expect {
    1|1
    2|3
    3|7
    4|8
}

# A FROM source that folds into the query reading it is read row by row, so it
# keeps seeing the rows the statement has already written. Building it once
# instead hands every row a snapshot taken before the first write.

test update-set-foldable-subquery-sees-earlier-writes {
    CREATE TABLE f(id INTEGER PRIMARY KEY, v INTEGER);
    INSERT INTO f VALUES(1,0),(2,0),(3,0),(4,0);
    UPDATE f SET v = coalesce((SELECT q FROM (SELECT id AS iid, v AS q FROM f) WHERE iid = f.id - 1), 0) + 1;
    SELECT id, v FROM f ORDER BY id;
}
expect {
    1|1
    2|2
    3|3
    4|4
}

test update-set-nested-foldable-subquery-sees-earlier-writes {
    CREATE TABLE n(id INTEGER PRIMARY KEY, v INTEGER);
    INSERT INTO n VALUES(1,0),(2,0),(3,0),(4,0);
    UPDATE n SET v = coalesce((SELECT q FROM (SELECT iid, q FROM (SELECT id AS iid, v AS q FROM n)) WHERE iid = n.id - 1), 0) + 1;
    SELECT id, v FROM n ORDER BY id;
}
expect {
    1|1
    2|2
    3|3
    4|4
}

test update-set-bare-aggregate-subquery-sees-earlier-writes {
    CREATE TABLE g(id INTEGER PRIMARY KEY, v INTEGER);
    INSERT INTO g VALUES(1,0),(2,0),(3,0),(4,0);
    UPDATE g SET v = coalesce((SELECT q FROM (SELECT 1 AS iid, sum(v) AS q FROM g) WHERE iid = g.id - 1), 0) + 1;
    SELECT id, v FROM g ORDER BY id;
}
expect {
    1|1
    2|2
    3|1
    4|1
}

test update-set-limited-subquery-sees-earlier-writes {
    CREATE TABLE l(id INTEGER PRIMARY KEY, v INTEGER);
    INSERT INTO l VALUES(1,0),(2,0),(3,0),(4,0);
    UPDATE l SET v = coalesce((SELECT q FROM (SELECT id AS iid, v AS q FROM l LIMIT 1) WHERE iid = l.id - 1), 0) + 1;
    SELECT id, v FROM l ORDER BY id;
}
expect {
    1|1
    2|2
    3|1
    4|1
}

test update-set-limited-window-subquery-sees-earlier-writes {
    CREATE TABLE lw(id INTEGER PRIMARY KEY, v INTEGER);
    INSERT INTO lw VALUES(1,0),(2,0),(3,0),(4,0);
    UPDATE lw SET v = coalesce((SELECT q FROM (SELECT id AS iid, sum(v) OVER () AS q FROM lw LIMIT 1) WHERE iid = lw.id - 1), 0) + 1;
    SELECT id, v FROM lw ORDER BY id;
}
expect {
    1|1
    2|2
    3|1
    4|1
}

test update-set-returning-sees-earlier-writes {
    CREATE TABLE r(id INTEGER PRIMARY KEY, v INTEGER);
    INSERT INTO r VALUES(1,0),(2,0),(3,0),(4,0);
    UPDATE r SET v = coalesce((SELECT q FROM (SELECT id AS iid, v AS q FROM r) WHERE iid = r.id - 1), 0) + 1 RETURNING id, v;
}
expect {
    1|1
    2|2
    3|3
    4|4
}

@requires trigger "uses triggers"
test update-set-trigger-written-table-sees-earlier-writes {
    CREATE TABLE a(id INTEGER PRIMARY KEY, v INTEGER);
    CREATE TABLE b(id INTEGER PRIMARY KEY, v INTEGER);
    INSERT INTO a VALUES(1,0),(2,0),(3,0),(4,0);
    INSERT INTO b VALUES(1,0),(2,0),(3,0),(4,0);
    CREATE TRIGGER tr AFTER UPDATE ON a BEGIN UPDATE b SET v = NEW.v WHERE id = NEW.id; END;
    UPDATE a SET v = coalesce((SELECT q FROM (SELECT id AS iid, v AS q FROM b) WHERE iid = a.id - 1), 0) + 1;
    SELECT id, v FROM a ORDER BY id;
}
expect {
    1|1
    2|2
    3|3
    4|4
}

# A FROM source that cannot fold in is built once, so every row of the statement
# reads the same rows no matter what the statement has written since.

test update-set-group-by-subquery-built-once {
    CREATE TABLE gb(id INTEGER PRIMARY KEY, v INTEGER);
    INSERT INTO gb VALUES(1,0),(2,0),(3,0),(4,0);
    UPDATE gb SET v = coalesce((SELECT q FROM (SELECT id AS iid, sum(v) AS q FROM gb GROUP BY id) WHERE iid = gb.id - 1), 0) + 1;
    SELECT id, v FROM gb ORDER BY id;
}
expect {
    1|1
    2|1
    3|1
    4|1
}

test update-set-distinct-subquery-built-once {
    CREATE TABLE ds(id INTEGER PRIMARY KEY, v INTEGER);
    INSERT INTO ds VALUES(1,0),(2,0),(3,0),(4,0);
    UPDATE ds SET v = coalesce((SELECT q FROM (SELECT DISTINCT id AS iid, v AS q FROM ds) WHERE iid = ds.id - 1), 0) + 1;
    SELECT id, v FROM ds ORDER BY id;
}
expect {
    1|1
    2|1
    3|1
    4|1
}

test update-set-compound-subquery-built-once {
    CREATE TABLE cp(id INTEGER PRIMARY KEY, v INTEGER);
    INSERT INTO cp VALUES(1,0),(2,0),(3,0),(4,0);
    UPDATE cp SET v = coalesce((SELECT q FROM (SELECT id AS iid, v AS q FROM cp UNION ALL SELECT -1,-1) WHERE iid = cp.id - 1), 0) + 1;
    SELECT id, v FROM cp ORDER BY id;
}
expect {
    1|1
    2|1
    3|1
    4|1
}

test update-set-window-subquery-built-once-range-probe-still-live {
    CREATE TABLE wr(id INTEGER PRIMARY KEY, v INTEGER);
    INSERT INTO wr VALUES(1,0),(2,0),(3,0),(4,0);
    UPDATE wr SET v = coalesce((SELECT max(q) FROM (SELECT id AS iid, sum(v) OVER () AS q FROM wr) WHERE iid <= wr.id - 1), 0) + 1;
    SELECT id, v FROM wr ORDER BY id;
}
expect {
    1|1
    2|2
    3|4
    4|8
}
