test update-set-window-eq-probe-text-column-real-value {
    CREATE TABLE te(id INTEGER PRIMARY KEY, k TEXT, r REAL, v INTEGER);
    INSERT INTO te VALUES(1,'1.0',1.0,1),(2,'2.0',2.0,2),(3,'3.0',3.0,3),(4,'4.0',4.0,4);
    UPDATE te SET v = (SELECT q FROM (SELECT k AS kk, row_number() OVER (ORDER BY v DESC) AS q FROM te) WHERE kk = te.r);
    SELECT id, coalesce(v,-1) FROM te ORDER BY id;
}
expect {
    1|4
    2|4
    3|4
    4|4
}

test update-set-window-eq-probe-on-a-computed-column {
    CREATE TABLE tf(id INTEGER PRIMARY KEY, v INTEGER);
    INSERT INTO tf VALUES(1,1),(2,2),(3,3),(4,4);
    UPDATE tf SET v = (SELECT q FROM (SELECT id+0 AS iid, row_number() OVER (ORDER BY v DESC) AS q FROM tf) WHERE iid = tf.id);
    SELECT id, coalesce(v,-1) FROM tf ORDER BY id;
}
expect {
    1|4
    2|4
    3|4
    4|4
}

