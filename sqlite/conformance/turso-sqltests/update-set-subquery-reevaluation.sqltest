test update-set-window-eq-probe-untyped-column-integer-value {
    CREATE TABLE td(id INTEGER PRIMARY KEY, k, v INTEGER);
    INSERT INTO td VALUES(1,1,1),(2,2,2),(3,3,3),(4,4,4);
    UPDATE td SET v = (SELECT q FROM (SELECT k AS kk, row_number() OVER (ORDER BY v DESC) AS q FROM td) WHERE kk = td.id);
