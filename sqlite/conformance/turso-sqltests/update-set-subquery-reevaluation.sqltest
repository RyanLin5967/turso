test update-set-window-eq-probe-real-column-integer-value {
    CREATE TABLE th(id INTEGER PRIMARY KEY, k REAL, v INTEGER);
    INSERT INTO th VALUES(1,1.0,1),(2,2.0,2),(3,3.0,3),(4,4.0,4);
    UPDATE th SET v = (SELECT q FROM (SELECT k AS kk, row_number() OVER (ORDER BY v DESC) AS q FROM th) WHERE kk = th.id);
