>> Q DROP SCHEMA IF EXISTS public CASCADE; CREATE SCHEMA public
   C DROP SCHEMA
   C CREATE SCHEMA
   Z I
>> Q CREATE TABLE t(id INT PRIMARY KEY, v TEXT)
   C CREATE TABLE
   Z I
>> Q INSERT INTO t VALUES (1, 'trunk')
   C INSERT 0 1
   Z I
>> Q BEGIN
   C BEGIN
   Z T
>> Q SET transaction_read_only = on
   E S=ERROR C=0A000 M=Parse error: READ ONLY transactions are not supported
   Z E
>> Q INSERT INTO t VALUES (2, 'two')
   E S=ERROR C=25P02 M=current transaction is aborted, commands ignored until end of transaction block
   Z E
>> Q ROLLBACK
   C ROLLBACK
   Z I
>> Q SELECT count(*) FROM t WHERE id = 2
   T oids=[20] names=['count']
   D ['0']
   C SELECT 1
   Z I
>> Q SET default_transaction_read_only = on
   E S=ERROR C=0A000 M=Parse error: READ ONLY transactions are not supported
   Z I
>> Q SET LOCAL transaction_read_only TO true
   E S=ERROR C=0A000 M=Parse error: READ ONLY transactions are not supported
   Z I
>> Q SET default_transaction_read_only = off
   C SET
   Z I
>> Q SET enable_seqscan = off
   C SET
   Z I
>> Q SET application_name = 'bench'
   C SET
   Z I
>> Q SET client_encoding = 'UTF8'
   C SET
   Z I
>> Q SET client_encoding = 'LATIN1'
   E S=ERROR C=0A000 M=Parse error: SET client_encoding = LATIN1 is not supported: this server answers only by its own setting of it
   Z I
>> Q SET standard_conforming_strings = off
   E S=ERROR C=0A000 M=Parse error: SET standard_conforming_strings = off is not supported: this server answers only by its own setting of it
   Z I
>> Q SET synchronous = off
   E S=ERROR C=42704 M=Parse error: unrecognized configuration parameter "synchronous"
   Z I
>> Q SET no_such_parameter = 1
   E S=ERROR C=42704 M=Parse error: unrecognized configuration parameter "no_such_parameter"
   Z I
>> Q INSERT INTO t VALUES (3, 'three')
   C INSERT 0 1
   Z I
