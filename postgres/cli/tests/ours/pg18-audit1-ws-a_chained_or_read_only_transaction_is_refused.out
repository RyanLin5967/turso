>> Q DROP SCHEMA IF EXISTS public CASCADE; CREATE SCHEMA public
   C DROP SCHEMA
   E S=ERROR C=42601 M=Parse error: schema "public" already exists
   Z I
>> Q CREATE TABLE t(id INT PRIMARY KEY, v TEXT)
   C CREATE TABLE
   Z I
>> Q INSERT INTO t VALUES (1, 'trunk')
   C INSERT 0 1
   Z I
>> Q COMMIT AND CHAIN
   E S=ERROR C=25P01 M=COMMIT AND CHAIN can only be used in transaction blocks
   Z I
>> Q ROLLBACK AND CHAIN
   E S=ERROR C=25P01 M=ROLLBACK AND CHAIN can only be used in transaction blocks
   Z I
>> Q END AND CHAIN
   E S=ERROR C=25P01 M=COMMIT AND CHAIN can only be used in transaction blocks
   Z I
>> Q BEGIN
   C BEGIN
   Z T
>> Q INSERT INTO t VALUES (2, 'two')
   C INSERT 0 1
   Z T
>> Q COMMIT AND CHAIN
   E S=ERROR C=0A000 M=AND CHAIN is not supported: end the block with COMMIT or ROLLBACK, then BEGIN a new one
   Z E
>> Q ROLLBACK
   C ROLLBACK
   Z I
>> Q SELECT count(*) FROM t WHERE id = 2
   T oids=[20] names=['count']
   D ['0']
   C SELECT 1
   Z I
>> Q BEGIN READ ONLY
   E S=ERROR C=0A000 M=Parse error: READ ONLY transactions are not supported
   Z I
>> Q START TRANSACTION READ ONLY
   E S=ERROR C=0A000 M=Parse error: READ ONLY transactions are not supported
   Z I
>> Q BEGIN ISOLATION LEVEL SERIALIZABLE, READ ONLY
   E S=ERROR C=0A000 M=Parse error: READ ONLY transactions are not supported
   Z I
>> Q BEGIN READ WRITE
   C BEGIN
   Z T
>> Q COMMIT
   C COMMIT
   Z I
