>> Q DROP SCHEMA IF EXISTS public CASCADE; CREATE SCHEMA public
   C DROP SCHEMA
   E S=ERROR C=42601 M=Parse error: schema "public" already exists
   Z I
>> Q CREATE TABLE t(id INT PRIMARY KEY, v TEXT)
   C CREATE TABLE
   Z I
>> Q INSERT INTO t VALUES (1, 'trunk')
   C INSERT 0 1
   Z I
>> Q BEGIN
   C BEGIN
   Z T
>> Q BEGIN READ ONLY
   E S=ERROR C=0A000 M=READ ONLY transactions are not supported
   Z E
>> Q INSERT INTO t VALUES (2, 'two')
   E S=ERROR C=25P02 M=current transaction is aborted, commands ignored until end of transaction block
   Z E
>> Q COMMIT
   C ROLLBACK
   Z I
>> Q INSERT INTO t VALUES (3, 'three'); BEGIN READ ONLY; INSERT INTO t VALUES (4, 'four'); COMMIT
   C INSERT 0 1
   E S=ERROR C=0A000 M=READ ONLY transactions are not supported
   Z I
>> Q SELECT count(*) FROM t WHERE id > 1
   T oids=[20] names=['count']
   D ['0']
   C SELECT 1
   Z I
>> Q ROLLBACK
   N S=WARNING C=25P01 M=there is no transaction in progress
   C ROLLBACK
   Z I
>> Q SELECT count(*) FROM t WHERE id > 1
   T oids=[20] names=['count']
   D ['0']
   C SELECT 1
   Z I
