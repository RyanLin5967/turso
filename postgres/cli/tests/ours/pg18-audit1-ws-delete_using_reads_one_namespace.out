>> Q SELECT count(*) FROM d
   T oids=[20] names=['count']
   D ['3']
   C SELECT 1
   Z I
>> Q DELETE FROM d USING d WHERE d.id = 1
   E S=ERROR C=42712 M=Parse error: table name "d" specified more than once
