   C INSERT 0 3
   Z I
>> Q CREATE TABLE k(id INT, flag BOOLEAN)
   C CREATE TABLE
   Z I
>> Q INSERT INTO k VALUES (2, true), (3, false)
   C INSERT 0 2
   Z I
>> Q DELETE FROM d USING k WHERE id = 2
   E S=ERROR C=42702 M=Parse error: ambiguous column name: id
