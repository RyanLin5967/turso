>> Q DROP SCHEMA IF EXISTS public CASCADE; CREATE SCHEMA public
   C DROP SCHEMA
   E S=ERROR C=42601 M=Parse error: schema "public" already exists
   Z I
>> Q CREATE TABLE t(id INT PRIMARY KEY, v TEXT)
   C CREATE TABLE
   Z I
>> Q INSERT INTO t VALUES (1, 'trunk')
   C INSERT 0 1
   Z I
>> Q BEGIN; INSERT INTO t VALUES (2, 'two'); CHECKPOINT; COMMIT
   C BEGIN
   C INSERT 0 1
   C CHECKPOINT
   C COMMIT
   Z I
>> Q SELECT count(*) FROM t
   T oids=[20] names=['count']
   D ['2']
   C SELECT 1
   Z I
