CREATE VIEW v AS SELECT b FROM n => 
CREATE TABLE c AS SELECT b FROM n => 
SELECT b + 1 AS x FROM n ORDER BY 1 => x:1700/-1/-1
SELECT b FROM n ORDER BY b => b:1700/-1/524294
SELECT b FROM v ORDER BY b => b:1700/-1/524294
SELECT b FROM (SELECT b FROM n) d ORDER BY b => b:1700/-1/524294
SELECT b FROM c ORDER BY b => b:1700/-1/524294
SELECT (SELECT max(b) FROM n) AS m => m:1700/-1/-1
