-- PG 18.6 on iccad2 (fresh initdb, lc_messages C): Parse/Bind/Execute/Sync rounds with exact parameter bytes (trailing spaces kept), which pgproto.py's scenario format strips; recorded by a raw v3 client (scratchpad rec8/sp.py)
>> Q CREATE TABLE vc(id int PRIMARY KEY, v varchar(5))
   C CREATE TABLE
   Z I
>> Q INSERT INTO vc VALUES (1, 'ab')
   C INSERT 0 1
   Z I
>> X 'INSERT INTO vc VALUES (3, $1)' ['abcdef'] declared []
   ParseComplete
   E S=ERROR C=22001 M=value too long for type character varying(5)
   Z I
>> X 'UPDATE vc SET v = $1 WHERE id = 1' ['abcdef'] declared []
   ParseComplete
   E S=ERROR C=22001 M=value too long for type character varying(5)
   Z I
>> X 'UPDATE vc SET v = $1 WHERE id = 1' ['ab      '] declared []
   ParseComplete
   BindComplete
   C UPDATE 1
   Z I
>> Q SELECT v, length(v) FROM vc WHERE id = 1
   T oids=[1043, 23]
   D ['ab   ', '5']
   C SELECT 1
   Z I
>> X 'UPDATE vc SET v = $1 WHERE id = 1' ['abcdef'] declared [25]
   ParseComplete
   E S=ERROR C=22001 M=value too long for type character varying(5)
   Z I
