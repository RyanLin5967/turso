>> Q DROP TABLE IF EXISTS idt, idb, gv
   N S=NOTICE C=00000 M=table "idt" does not exist, skipping
   N S=NOTICE C=00000 M=table "idb" does not exist, skipping
   N S=NOTICE C=00000 M=table "gv" does not exist, skipping
   C DROP TABLE
   Z I
>> Q create table idt (id int generated always as identity, v text)
   C CREATE TABLE
   Z I
>> Q insert into idt (v) values ('a'), ('b')
   C INSERT 0 2
   Z I
>> Q create table idb (id bigint generated by default as identity primary key, v text)
   C CREATE TABLE
   Z I
>> Q insert into idb (v) values ('a'), ('b')
   C INSERT 0 2
   Z I
>> Q create table gv (a int, b int generated always as (a * 2) virtual)
   C CREATE TABLE
   Z I
>> Q insert into gv (a) values (3)
   C INSERT 0 1
   Z I
>> Q select * from idt
   T oids=[23, 25]
   D ['1', 'a']
   D ['2', 'b']
   C SELECT 2
   Z I
>> Q select * from idb
   T oids=[20, 25]
   D ['1', 'a']
   D ['2', 'b']
   C SELECT 2
   Z I
>> Q select * from gv
   T oids=[23, 23]
   D ['3', '6']
