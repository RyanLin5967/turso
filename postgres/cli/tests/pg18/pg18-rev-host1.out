>> [a] Q CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT DEFAULT 'unknown', score INTEGER DEFAULT 0)
   C CREATE TABLE
   Z I
>> [a] Q INSERT INTO t (id, name, score) VALUES (1, DEFAULT, 42)
   C INSERT 0 1
   Z I
>> [a] Q INSERT INTO t (id, name, score) VALUES (2, 'alice', DEFAULT), (3, DEFAULT, 99)
   C INSERT 0 2
   Z I
>> [a] Q INSERT INTO t (id, name, score) VALUES (DEFAULT, DEFAULT, DEFAULT)
   E S=ERROR C=23502 M=null value in column "id" of relation "t" violates not-null constraint
   Z I
>> [a] Q SELECT id, name, score FROM t ORDER BY id
   T oids=[23, 25, 23] names=['id', 'name', 'score']
   D ['1', 'unknown', '42']
   D ['2', 'alice', '0']
   D ['3', 'unknown', '99']
   C SELECT 3
   Z I
