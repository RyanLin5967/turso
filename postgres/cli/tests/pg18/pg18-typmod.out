CREATE TABLE tm(a int2, b int4, c int8, d bool, e float4, f float8, g text, h varchar(5), i numeric(8,2), j numeric, k char(3), l date, m timestamp, n timestamptz, o uuid, p bytea, q json, r jsonb, s time, t varchar);
SELECT * FROM tm;
SELECT a + 1 AS x, i * 2 AS y, h || 'z' AS z, count(*) AS w FROM tm GROUP BY a, i, h;
SELECT 1 AS one, 'x' AS lit, 1.5 AS dec, true AS b, NULL AS nul, now() AS ts
