>> Q select * from generate_series(0::numeric, 'inf'::numeric, 10::numeric)
   T oids=[1700] names=['generate_series']
   E S=ERROR C=22023 M=stop value cannot be infinity
   Z I
>> Q select * from generate_series(0, 'inf'::float8, 10)
   E S=ERROR C=42883 M=function generate_series(integer, double precision, integer) does not exist
   Z I
>> Q select * from generate_series(1, 3, 'inf'::numeric)
   T oids=[1700] names=['generate_series']
   E S=ERROR C=22023 M=step size cannot be infinity
   Z I
>> Q select * from generate_series('-inf'::numeric, 0, 10)
   T oids=[1700] names=['generate_series']
   E S=ERROR C=22023 M=start value cannot be infinity
   Z I
>> Q select count(*) from generate_series(1, 5)
   T oids=[20] names=['count']
   D ['5']
   C SELECT 1
   Z I
