>> Q CREATE TABLE ec (id int PRIMARY KEY, n numeric, f float8, r real)
   C CREATE TABLE
   Z I
>> Q INSERT INTO ec VALUES (1, 2.5, 2.5, 2.5), (2, -2.5, -2.5, -2.5), (3, 1.5, 1.5, 1.5), (4, 0.5, 0.5, 0.5)
   C INSERT 0 4
   Z I
>> Q SELECT -((-('1.5'::numeric))::bigint) AS v
   T oids=[20]
   D ['2']
   C SELECT 1
   Z I
>> Q SELECT (('2.5'::numeric) + 0)::int AS a, ((2.5)::float8 + 0)::int AS b, ((3.5)::float8 * 1)::int AS c, (-(2.5::float8) * 1)::int AS d
   T oids=[23, 23, 23, 23]
   D ['3', '2', '4', '-2']
   C SELECT 1
   Z I
>> Q SELECT id, (n * 1)::int AS ni, (f * 1)::int AS fi, (r + 0)::int AS ri, (n + 0)::int8 AS n8, (f + 0)::smallint AS f2 FROM ec ORDER BY id
   T oids=[23, 23, 23, 23, 20, 21]
   D ['1', '3', '2', '2', '3', '2']
   D ['2', '-3', '-2', '-2', '-3', '-2']
   D ['3', '2', '2', '2', '2', '2']
   D ['4', '1', '0', '0', '1', '0']
   C SELECT 4
   Z I
>> Q SELECT id FROM ec WHERE (n * 1)::int = 3 ORDER BY id
   T oids=[23]
   D ['1']
   C SELECT 1
   Z I
>> Q SELECT id FROM ec WHERE (f * 1)::int = 2 ORDER BY id
   T oids=[23]
   D ['1']
   D ['3']
   C SELECT 2
   Z I
>> Q CREATE VIEW ecv AS SELECT id, (n * 1)::int AS ni, (f / 1)::int AS fi FROM ec
   C CREATE VIEW
   Z I
>> Q SELECT id, ni, fi FROM ecv ORDER BY id
   T oids=[23, 23, 23]
   D ['1', '3', '2']
   D ['2', '-3', '-2']
   D ['3', '2', '2']
   D ['4', '1', '0']
   C SELECT 4
   Z I
>> Q SELECT (abs(n) * 1)::int AS v FROM ec WHERE id = 2
   T oids=[23]
   D ['3']
   C SELECT 1
   Z I
>> Q SELECT (round(f, 1) + 0)::int FROM ec WHERE id = 1
   E S=ERROR C=42883 M=function round(double precision, integer) does not exist
   Z I
